// Data model from PLAN.md §4.
// Enums = closed lists fixed by the task (identifier types, address categories) and lifecycle states.
// Plain strings = registries that plugins extend (chain, sourceType, contextType, band, notification kind);
// their allowed values live in packages/core.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IdentifierType {
  NAME
  NICK
  MESSENGER
  SOCIAL_LOGIN
  EMAIL
  ADDRESS
}

enum AddressCategory {
  UNHOSTED
  CEX_CUSTODIAL
  CEX_DEPOSIT
  CONTRACT
  DEX
  CASP_KANTOR
  PAYMENT_GATEWAY
  CRYPTO_CARD
  MIXER
  CHARITY
  SANCTIONED
  EXAMPLE_BURN
  UNKNOWN_SERVICE
}

enum RunStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum AnalystDecision {
  CONFIRMED
  REJECTED
}

enum ReportFormat {
  HTML
  PDF
  JSON
}

model Case {
  id            String   @id @default(uuid())
  title         String
  createdAt     DateTime @default(now())
  createdBy     String
  scheduleCron  String?
  retentionDays Int? // null = keep until the case is deleted

  identifiers   Identifier[]
  runs          Run[]
  diffs         RunDiff[]
  notifications Notification[]
}

model Identifier {
  id         String         @id @default(uuid())
  caseId     String
  type       IdentifierType
  value      String
  normalized String

  case   Case    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  traces Trace[]
  links  Link[]

  @@index([caseId])
}

model Run {
  id           String    @id @default(uuid())
  caseId       String
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  status       RunStatus @default(PENDING)
  rulesVersion String
  appVersion   String
  paramsJson   Json // inputs: connectors, asOf, chain mode …
  summaryJson  Json? // outputs: stats, connector / chain errors, identities of an address case

  case          Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  evidence      Evidence[]
  traces        Trace[]
  links         Link[]
  snapshots     ChainSnapshot[]
  diffsFrom     RunDiff[]       @relation("DiffFrom")
  diffsTo       RunDiff[]       @relation("DiffTo")
  notifications Notification[]
  reports       Report[]

  @@index([caseId, startedAt])
}

model Evidence {
  id          String   @id @default(uuid())
  runId       String
  connectorId String
  url         String?
  resourceId  String?
  fetchedAt   DateTime
  sha256      String
  snippet     String
  archiveUrl  String?
  sourceType  String
  metaJson    Json     @default("{}")

  run    Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  traces Trace[]

  @@index([runId])
}

model Trace {
  id             String  @id @default(uuid())
  runId          String
  evidenceId     String
  identifierId   String?
  chain          String
  address        String
  contextType    String
  contextSnippet String
  position       Int

  run        Run         @relation(fields: [runId], references: [id], onDelete: Cascade)
  evidence   Evidence    @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  identifier Identifier? @relation(fields: [identifierId], references: [id], onDelete: SetNull)

  @@index([runId])
  @@index([chain, address])
}

model Address {
  id         String          @id @default(uuid())
  chain      String
  address    String
  category   AddressCategory
  labelsJson Json            @default("[]")
  isContract Boolean? // null = not checked
  firstSeen  DateTime?
  lastSeen   DateTime?
  metaJson   Json            @default("{}")

  links     Link[]
  snapshots ChainSnapshot[]

  @@unique([chain, address])
}

model Link {
  id              String           @id @default(uuid())
  runId           String
  identifierId    String
  addressId       String
  score           Int
  band            String
  breakdownJson   Json
  hintsJson       Json             @default("[]")
  excludedReason  String?
  analystDecision AnalystDecision?
  analystNote     String?
  analystName     String? // who decided; shown next to the computed score, never changes it
  decidedAt       DateTime?

  run        Run        @relation(fields: [runId], references: [id], onDelete: Cascade)
  identifier Identifier @relation(fields: [identifierId], references: [id], onDelete: Cascade)
  address    Address    @relation(fields: [addressId], references: [id])

  @@unique([runId, identifierId, addressId])
  @@index([addressId])
}

model ChainSnapshot {
  id             String   @id @default(uuid())
  runId          String
  addressId      String
  indicatorsJson Json
  flowsJson      Json
  fetchedAt      DateTime
  provider       String

  run     Run     @relation(fields: [runId], references: [id], onDelete: Cascade)
  address Address @relation(fields: [addressId], references: [id])

  @@index([runId])
  @@index([addressId])
}

model RunDiff {
  id        String @id @default(uuid())
  caseId    String
  fromRunId String
  toRunId   String
  diffJson  Json

  case    Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromRun Run  @relation("DiffFrom", fields: [fromRunId], references: [id], onDelete: Cascade)
  toRun   Run  @relation("DiffTo", fields: [toRunId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model Notification {
  id      String    @id @default(uuid())
  caseId  String
  runId   String?
  kind    String
  message String
  readAt  DateTime?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  run  Run? @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// Egress audit trail. No FKs on purpose: the log must survive "delete case".
model AuditLog {
  id          String   @id @default(uuid())
  at          DateTime @default(now())
  caseId      String?
  runId       String?
  connectorId String
  host        String
  path        String // without query secrets
  status      Int
  durationMs  Int

  @@index([at])
}

model Report {
  id        String       @id @default(uuid())
  runId     String
  format    ReportFormat
  sha256    String
  createdAt DateTime     @default(now())
  path      String

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}
