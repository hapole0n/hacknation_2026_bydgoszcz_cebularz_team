# Copy to .env and fill in. Never commit .env. Never paste keys into chats.
DATABASE_URL=postgresql://olcys:olcys@localhost:5432/olcys
API_PORT=3000
WEB_PORT=5173
SANDBOX_BASE_URL=http://localhost:8088

ETHERSCAN_API_KEY=
TRONGRID_API_KEY=
GITHUB_TOKEN=
GRAVATAR_API_KEY=
# Live access to t.me (public pages). OFF by default: Telegram's terms restrict access to user content (https://telegram.org/tos/content-licensing). Synthetic names are served by the sandbox either way.
TELEGRAM_LIVE=false
# Public Ethereum RPC for ENS (eth_call only). If you change the host, add it to config/egress-allowlist.yaml.
ETH_RPC_URL=https://ethereum-rpc.publicnode.com

NBP_API_BASE=https://api.nbp.pl/api
COINGECKO_ENABLED=false

AI_ENABLED=false
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=

EGRESS_ALLOWLIST_FILE=config/egress-allowlist.yaml
SCORING_RULES_FILE=config/scoring-rules.v1.yaml
